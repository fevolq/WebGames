{
  "name": "webgames-playroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && tsx scripts/generate-routes.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:ui": "vitest run src/pages/lobby/Lobby.test.tsx",
    "check": "npm test && npm run build",
    "test:deployment": "tsx scripts/smoke-http.ts"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
